# 複製為 .env.local 後填入。不得提交任何實際值。
# 瀏覽器只可使用 anon key（C-09）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 只存在伺服器環境變數（C-09）
SUPABASE_SERVICE_ROLE_KEY=
# 本站對外網址，用於 Origin 驗證（C-11）
SITE_URL=http://localhost:3000
# T31：旅前再核實排程端點 /api/cron/reverify 的驗證值（Vercel Cron 以 Authorization: Bearer 傳送），至少 16 字元
CRON_SECRET=
# Google 登入（D05）：取得 Google OAuth client 後填入，並將 supabase/config.toml 的 google 改為 enabled
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# AI 與外部 API key 一律由使用者在設定頁輸入並存入 Vault（C-02、D15），此處不設定
